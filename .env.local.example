# MODUS — environment variables (apps/web)
# Copy to apps/web/.env.local and fill in. Vars prefixed NEXT_PUBLIC_ are exposed
# to the browser; everything else is server-only. Production values live in Vercel.

# ── Firebase (client-side) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=        # Web Push (FCM) public VAPID key

# ── Firebase Admin (server-side) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                  # keep the \n escapes; wrap in quotes
FIREBASE_STORAGE_BUCKET=              # e.g. modus-pilot.firebasestorage.app (newer projects are NOT .appspot.com)

# ── AI providers ──
GROQ_API_KEY=                          # Llama default + Auto classifier + Whisper transcription
OPENAI_API_KEY=                        # GPT-4o, o4-mini, vision, image gen, TTS
ANTHROPIC_API_KEY=                     # Claude Sonnet / Opus
GOOGLE_GENERATIVE_AI_API_KEY=          # Gemini 2.5 Pro
XAI_API_KEY=                           # Grok 3
TAVILY_API_KEY=                        # web search

# ── Memory (Pinecone) ──
PINECONE_API_KEY=

# ── OAuth connectors ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional: signs OAuth `state`. Falls back to FIREBASE_PRIVATE_KEY if unset.
OAUTH_STATE_SECRET=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MODUS=                    # recurring price id — $24 plan
STRIPE_PRICE_PILOT=                    # recurring price id — $59 plan
STRIPE_PRICE_GROUP=                    # recurring price id — $79 group plan

# ── App ──
NEXT_PUBLIC_APP_URL=                   # e.g. https://app.moduspilot.com
CRON_SECRET=                           # protects /api/cron/daily-briefing (Vercel Cron)
