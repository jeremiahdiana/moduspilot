{
  "name": "modus-desktop",
  "version": "0.3.1",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "dev:assist": "npm run build && electron scripts/dev-screen-assist.js",
    "verify:screen": "npm run build && electron scripts/verify-screen-capture.js",
    "verify:watch": "npx tsx scripts/verify-watch-diff.ts",
    "verify:assist": "npx tsx scripts/verify-assist-protocol.ts",
    "watch": "tsc -p tsconfig.json --watch",
    "dist": "npm run build && electron-builder --mac",
    "release": "node scripts/preflight-release.js && npm run build && electron-builder --mac --publish always",
    "verify:sync": "npx tsx scripts/verify-source-envelope.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "firebase": "^10.14.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.0"
  }
}
