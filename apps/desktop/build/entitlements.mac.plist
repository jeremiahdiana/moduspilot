<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 JIT needs these under the hardened runtime required by notarization. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Needed so the app can load its native module (better-sqlite3). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Touch ID / Secure Enclave platform authenticator for WebAuthn (passkeys)
       inside the login window's Google/Apple OAuth flow. Must exactly match the
       keychainAccessGroup passed to app.configureWebAuthn() in src/main/index.ts.
       Form is <TEAM_ID>.<BUNDLE_ID>.webauthn. -->
  <key>keychain-access-groups</key>
  <array>
    <string>8KF5J7X9BU.com.moduspilot.desktop.webauthn</string>
  </array>
</dict>
</plist>
