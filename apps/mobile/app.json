{
  "expo": {
    "name": "MODUS",
    "slug": "modus-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "modus",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.moduspilot.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow MODUS to use the microphone for voice input in chat.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "modus",
              "com.googleusercontent.apps.208739557361-tl9n4r3t8gku6qcen09l4b0uscoo1c3m"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-apple-authentication"
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0f"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow MODUS to use the microphone for voice input in chat."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a49800f1-f1a5-4adb-8c7e-b28c5447903c"
      }
    },
    "owner": "jerehmjr"
  }
}
