rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default deny ──────────────────────────────────────────────────────────
    // No one can read or write anything unless a rule below explicitly allows it.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── User data ─────────────────────────────────────────────────────────────
    // A signed-in user can read/write their own document and subcollections,
    // but cannot touch billing or rate-limit fields — those are server-only.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Clients may create their own profile but cannot set billing fields.
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys()
            .hasAny(['plan', 'dailyMessages', 'usageDate', 'modusPilotSignupAt',
                     'dailyTokens', 'tokenDate', 'weeklyTokens', 'tokenWeek']);

      // Clients may update their own profile but cannot touch billing fields.
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plan', 'dailyMessages', 'usageDate', 'modusPilotSignupAt',
                     'dailyTokens', 'tokenDate', 'weeklyTokens', 'tokenWeek']);

      // Deletion is server-only (account deletion flow uses Admin SDK).
      allow delete: if false;

      // Covers: conversations, goals, tasks, habits, memories, fcmTokens,
      //         google_accounts, mcpServers, events, drafts — all one level deep.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Shared conversations ──────────────────────────────────────────────────
    // Both the public /s/[shareId] page and the share API routes read these via
    // the Admin SDK (which bypasses rules), so clients never need direct access.
    // Denying client reads stops anyone from scraping the raw doc — which holds
    // the owner's uid and full message text — straight out of Firestore.
    match /sharedConversations/{shareId} {
      allow read, write: if false;
    }

    // ── Groups (MODUS Group plan) ─────────────────────────────────────────────
    // A group is a small set of members, each with their own private MODUS. The
    // group doc carries `memberUids` purely so rules can gate access — all writes
    // to it (and to membership) go through Admin SDK routes that keep the array
    // consistent, so clients can only ever READ the group, never mutate it.
    function isGroupMember(groupId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false; // server-only (Admin SDK)

      // Per-member docs hold display info + that member's sharing preferences.
      // Everyone in the group can read them; a member may update ONLY their own
      // (to toggle what their MODUS shares). Membership changes are server-only.
      match /members/{memberUid} {
        allow read: if isGroupMember(groupId);
        allow update: if request.auth != null && request.auth.uid == memberUid
                      && isGroupMember(groupId);
        allow create, delete: if false;
      }

      // The shared group space (trips, plans, notes the whole group can see).
      // Any member can read and contribute.
      match /shared/{docId} {
        allow read, write: if isGroupMember(groupId);
      }
    }

    // ── Group invites ─────────────────────────────────────────────────────────
    // Readable only by the invited email or the inviter; created/accepted/revoked
    // exclusively through Admin SDK routes.
    match /groupInvites/{inviteId} {
      allow read: if request.auth != null &&
        (request.auth.token.email == resource.data.email ||
         request.auth.uid == resource.data.invitedByUid);
      allow write: if false;
    }
  }
}
