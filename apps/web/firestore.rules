rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default deny ──────────────────────────────────────────────────────────
    // No one can read or write anything unless a rule below explicitly allows it.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── User data ─────────────────────────────────────────────────────────────
    // A signed-in user can only read and write their own document and
    // subcollections. No user can touch another user's data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Covers: conversations, goals, tasks, habits, memories, fcmTokens,
      //         google_accounts, mcpServers, events, drafts — all one level deep.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Shared conversations ──────────────────────────────────────────────────
    // Public read so anyone with a share link can view the conversation.
    // Writes are server-only (Firebase Admin SDK bypasses these rules entirely),
    // so we deny client writes here.
    match /sharedConversations/{shareId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
