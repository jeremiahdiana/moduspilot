rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default deny ──────────────────────────────────────────────────────────
    // No one can read or write anything unless a rule below explicitly allows it.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── User data ─────────────────────────────────────────────────────────────
    // A signed-in user can read/write their own document and subcollections,
    // but cannot touch billing or rate-limit fields — those are server-only.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Clients may create their own profile but cannot set billing fields.
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys()
            .hasAny(['plan', 'dailyMessages', 'usageDate', 'modusPilotSignupAt',
                     'dailyTokens', 'tokenDate']);

      // Clients may update their own profile but cannot touch billing fields.
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plan', 'dailyMessages', 'usageDate', 'modusPilotSignupAt',
                     'dailyTokens', 'tokenDate']);

      // Deletion is server-only (account deletion flow uses Admin SDK).
      allow delete: if false;

      // Covers: conversations, goals, tasks, habits, memories, fcmTokens,
      //         google_accounts, mcpServers, events, drafts — all one level deep.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Shared conversations ──────────────────────────────────────────────────
    // Public read so anyone with a share link can view the conversation.
    // Writes are server-only (Firebase Admin SDK bypasses these rules entirely),
    // so we deny client writes here.
    match /sharedConversations/{shareId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
